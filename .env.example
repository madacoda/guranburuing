# ==============================================================================
# Granblue Fantasy Remote Controller & Automation System - Environment Template
# Copy this file to .env and configure your preferences:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gateway Server & Remote Cockpit (Port 3000 / PWA)
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Bearer token for client authentication (min 16 characters)
AUTH_TOKEN=your_secure_random_bearer_token_at_least_16_chars

# ------------------------------------------------------------------------------
# 2. Environment Profile & VPS Performance Tuning
# ------------------------------------------------------------------------------
# Active environment: 'local' (development/Windows) or 'production' (Ubuntu VPS)
# Auto-detects 'production' on headless Linux VPS instances
APP_ENV=production

# Primary CDP remote debugging port (default: 9222)
CDP_PORT=9222
# Headless background execution: true (silent on VPS) or false (windowed on local)
HEADLESS=true
# Automatic Chromium launch on workflow start
AUTO_LAUNCH_CHROME=true
# Execution mode: 'dom' (high-throughput in-page tap for VPS) or 'hybrid'
EXECUTION_MODE=dom
# Speed Profile: 'turbo' (minimum delays for low-latency Tokyo ping), 'fast', 'stealth'
SPEED_PROFILE=turbo
# CreateJS Ticker Framerate: 60 (sweet spot for 2 vCPU), 30 (low-spec), or 120 (GPU local)
TICKER_FPS=60
# Automatically mute in-game audio to eliminate CPU WebAudio decoding
AUTO_MUTE_GAME=true
# Viewport resolution: 360x720 (44% fewer pixels to software-render on VPS) vs 480x960
VIEWPORT_WIDTH=360
VIEWPORT_HEIGHT=720
# V8 Heap & Cache for 2048MB VPS (stops GC pauses and disk thrashing)
V8_MAX_OLD_SPACE=1024
DISK_CACHE_SIZE=536870912
# Fast combat reload animation cancellation
COMBAT_AUTO_REFRESH=true

# ------------------------------------------------------------------------------
# 3. Discord Integration (Interactive Controller, DM Relay & Drop Alerts)
# ------------------------------------------------------------------------------
# Discord Bot Token (Required for 2-Way CAPTCHA Relay & Remote Controller)
DISCORD_BOT_TOKEN=
# Your Discord User Snowflake ID (Required for 1-on-1 DM Relay & Command Whitelist)
DISCORD_USER_ID=
# Optional Webhook URL for channel broadcast drop alerts
DISCORD_WEBHOOK_URL=
# Discord Rich Presence application ID
DISCORD_CLIENT_ID=1554396837127921714
# Enable / disable Discord Rich Presence gateway connection
DISCORD_PRESENCE_ENABLED=true
# Discord Presence Mode: 'gbf' (in-game state), 'work' (productivity), 'trade' (market)
DISCORD_PRESENCE_MODE=gbf
DISCORD_PRESENCE_PROJECT=Every Hero

# ------------------------------------------------------------------------------
# 4. Telegram Alerts (Optional Emergency Relay)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 5. Drop Telemetry & Streak Metrics
# ------------------------------------------------------------------------------
# Dry streak tracking mode: 'blue_chest' (default), 'min_honor', 'all_battles'
DRY_STREAK_MODE=blue_chest
