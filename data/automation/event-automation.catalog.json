{
  "$schema": "../schemas/event-automation.schema.json",
  "version": "2.0.0",
  "generatedAt": "2026-10-08T00:00:00.000Z",
  "description": "Granblue Fantasy monthly scenario event (treasureraid) story auto-clearing, token gacha (Senka Drawbox) reset heuristics, and Nightmare skip rules.",
  "storyPipeline": {
    "maxEpisodesPerEvent": 40,
    "cutsceneHandling": {
