{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RaidCatalogSchema",
  "type": "object",
  "required": ["version", "raids"],
  "properties": {
    "version": { "type": "string" },
    "generatedAt": { "type": "string" },
    "description": { "type": "string" },
    "raids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "stageId", "questId", "apCost", "epCost", "battleSystem"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "commonName": { "type": "string" },
          "japaneseName": { "type": "string" },
          "nickname": { "type": "string" },
          "category": { "type": "string" },
          "stageId": { "type": "string" },
          "questId": { "type": "string" },
          "chapterId": { "type": "string" },
          "apCost": { "type": "number" },
          "epCost": { "type": "number" },
          "maxPlayers": { "type": "number" },
          "bossHp": { "type": "number" },
          "element": { "type": "string" },
          "battleSystem": { "type": "string", "enum": ["V1", "V2"] },
          "dailyLimit": { "type": "number" },
          "hostMaterials": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "itemId", "count"],
              "properties": {
                "name": { "type": "string" },
                "itemId": { "type": "string" },
                "count": { "type": "number" }
              }
            }
          },
          "blueChest": {
            "type": "object",
            "properties": {
              "thresholdHonors": { "type": "number" },
              "guaranteedDamage": { "type": "number" },
              "goldBrickChance": { "type": "number" },
              "eternitySandChance": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
