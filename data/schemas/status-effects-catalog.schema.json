{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbf.wiki/schemas/status-effects-catalog.schema.json",
  "title": "GBFStatusEffectsAndDispelCleanseCatalog",
  "description": "Gold Industry Standard schema for Granblue Fantasy status effects, boss buffs, party debuffs, dispel/cleanse taxonomy, and autonomous survival decision trees.",
  "type": "object",
  "required": ["version", "generatedAt", "description", "bossBuffs", "partyDebuffs", "dispelSources", "cleanseSources", "decisionEngine"],
  "properties": {
    "version": { "type": "string" },
    "generatedAt": { "type": "string" },
    "description": { "type": "string" },
    "bossBuffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "dispelPriority", "removable", "threatLevel", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "japaneseName": { "type": "string" },
          "category": { "type": "string", "enum": ["defensive", "offensive", "utility", "special"] },
          "dispelPriority": { "type": "string", "enum": ["immediate", "high", "normal", "low", "ignore"] },
          "removable": { "type": "boolean" },
          "threatLevel": { "type": "string", "enum": ["wipe", "high", "medium", "low"] },
          "description": { "type": "string" },
          "commonBosses": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "partyDebuffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "cleansePriority", "cleanseable", "blockableByVeil", "threatLevel", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "japaneseName": { "type": "string" },
          "category": { "type": "string", "enum": ["lockout", "lethal_dot", "offensive_penalty", "defensive_penalty", "special"] },
          "cleansePriority": { "type": "string", "enum": ["immediate", "high", "normal", "low", "ignore"] },
          "cleanseable": { "type": "boolean" },
          "blockableByVeil": { "type": "boolean" },
          "threatLevel": { "type": "string", "enum": ["wipe", "high", "medium", "low"] },
          "description": { "type": "string" },
          "incompatibleActions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "dispelSources": {
      "type": "object",
      "required": ["summons", "mcSkills", "characterHighlights"],
      "properties": {
        "summons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "dispelsCount", "conditions", "priorityScore"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "callName": { "type": "string" },
              "dispelsCount": { "type": "number" },
              "conditions": { "type": "string" },
              "priorityScore": { "type": "number" }
            }
          }
        },
        "mcSkills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "classCategory", "dispelsCount", "cooldownTurns"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "classCategory": { "type": "string" },
              "dispelsCount": { "type": "number" },
              "cooldownTurns": { "type": "number" },
              "notes": { "type": "string" }
            }
          }
        },
        "characterHighlights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "element", "dispelsCount", "triggerMechanism"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "element": { "type": "string" },
              "dispelsCount": { "type": "number" },
              "triggerMechanism": { "type": "string" }
            }
          }
        }
      }
    },
    "cleanseSources": {
      "type": "object",
      "required": ["mcSkills", "summons", "characterHighlights"],
      "properties": {
        "mcSkills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "actionType", "cooldownTurns"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "actionType": { "type": "string", "enum": ["cleanse", "veil", "hybrid"] },
              "cooldownTurns": { "type": "number" },
              "notes": { "type": "string" }
            }
          }
        },
        "summons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "actionType"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "actionType": { "type": "string" }
            }
          }
        },
        "characterHighlights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "element", "actionType"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "element": { "type": "string" },
              "actionType": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "decisionEngine": {
      "type": "object",
      "required": ["dispelEvaluationRules", "cleanseEvaluationRules", "zombifiedSafetyInterlock"],
      "properties": {
        "dispelEvaluationRules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "rule", "action"],
            "properties": {
              "step": { "type": "number" },
              "rule": { "type": "string" },
              "action": { "type": "string" }
            }
          }
        },
        "cleanseEvaluationRules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "rule", "action"],
            "properties": {
              "step": { "type": "number" },
              "rule": { "type": "string" },
              "action": { "type": "string" }
            }
          }
        },
        "zombifiedSafetyInterlock": {
          "type": "object",
          "required": ["enabled", "rule", "lockoutActions"],
          "properties": {
            "enabled": { "type": "boolean" },
            "rule": { "type": "string" },
            "lockoutActions": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
