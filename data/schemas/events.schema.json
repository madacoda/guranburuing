{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MasterEventsCatalogSchema",
  "type": "object",
  "required": ["version", "events"],
  "properties": {
    "version": { "type": "string" },
    "generatedAt": { "type": "string" },
    "description": { "type": "string" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rawId", "type", "title", "japaneseTitle", "hashRoute", "status", "elements"],
        "properties": {
          "id": { "type": "string" },
          "rawId": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["collaboration", "treasureraid", "unite_and_fight", "dread_barrage", "xeno_clash", "story_side", "tower_of_babyl"]
          },
          "title": { "type": "string" },
          "japaneseTitle": { "type": "string" },
          "hashRoute": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["active", "rerun", "archived", "upcoming", "ended"]
          },
          "period": {
            "type": "object",
            "properties": {
              "startDate": { "type": "string" },
              "endDate": { "type": "string" },
              "exchangeDeadline": { "type": "string" }
            }
          },
          "elements": {
            "type": "object",
            "required": ["bossElements", "playerAdvantageousElements"],
            "properties": {
              "bossElements": {
                "type": "array",
                "items": { "type": "string" }
              },
              "playerAdvantageousElements": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "detailCatalog": { "type": "string" },
          "features": {
            "type": "object",
            "properties": {
              "hasTreasureTrade": { "type": "boolean" },
              "hasTokenDrawbox": { "type": "boolean" },
              "hasDailyMissions": { "type": "boolean" },
              "hasChallengeQuest": { "type": "boolean" },
              "hasNightmareHellSkip": { "type": "boolean" },
              "recruitableCharactersCount": { "type": "number" },
              "hasFlbWeapon": { "type": "boolean" },
              "hasFlbSummon": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
