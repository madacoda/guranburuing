  "combatFormulas": {
    "damageToHonors": {
      "formula": "Math.floor(damage / 1000)",
      "sample": "148,000,000 dmg => 1,480,000 honors"
    },
    "lockoutSeconds": {
      "base": 1.0,
      "hitMultiplier": 0.35,
      "ougiMultipliers": {
        "0": 0.0,
        "1": 4.0,
        "2": 6.5,
        "3": 9.0,
        "4": 13.0,
        "overBurst": 16.0
      },
      "formula": "base + (totalHits * hitMultiplier) + ougiPenalty"
    }
  },
