      "path": "/quest/raid_info",
      "method": "POST",
      "headers": {
        "X-Requested-With": "XMLHttpRequest",
        "Content-Type": "application/json"
      },
      "description": "Polls active raid HP percentage, member count, and personal contribution honors."
    },
