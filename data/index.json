      "path": "/rest/multiraid/start.json",
      "method": "POST",
      "headers": {
        "X-Requested-With": "XMLHttpRequest",
        "Content-Type": "application/json"
      },
      "description": "Initializes battle state, character HP, skills, and boss parameters."
    },
    "normalAttack": {
      "path": "/rest/multiraid/normal_attack_result.json",
      "method": "POST",
      "headers": {
        "X-Requested-With": "XMLHttpRequest",
        "Content-Type": "application/json"
      },
      "description": "Executes turn attack; returns scenario animation and server-resolved outcome."
    },
    "ability": {
      "path": "/rest/multiraid/ability_result.json",
      "method": "POST",
      "headers": {
        "X-Requested-With": "XMLHttpRequest",
        "Content-Type": "application/json"
      },
      "description": "Activates single character ability. Requires serial execution."
    },
    "summon": {
      "path": "/rest/multiraid/summon_result.json",
      "method": "POST",
      "headers": {
        "X-Requested-With": "XMLHttpRequest",
        "Content-Type": "application/json"
      },
      "description": "Invokes summon. Limited to once per turn."
    },
    "guardSetting": {
      "path": "/rest/multiraid/guard_setting.json",
      "method": "POST",
      "headers": {
        "X-Requested-With": "XMLHttpRequest",
        "Content-Type": "application/json"
      },
      "description": "Toggles V2 battle system character guard state."
    },
    "requestBackup": {
      "path": "/rest/multiraid/request_assist.json",
      "method": "POST",
      "headers": {
        "X-Requested-With": "XMLHttpRequest",
        "Content-Type": "application/json"
      },
      "description": "Broadcasts backup request to Everyone, Friends, and Crew."
    },
    "temporaryItem": {
      "path": "/rest/multiraid/temporary_item_result.json",
      "method": "POST",
      "headers": {
        "X-Requested-With": "XMLHttpRequest",
        "Content-Type": "application/json"
      },
      "description": "Consumes green or blue potions during combat."
    },
    "proSkip": {
      "path": "/quest/pro_skip",
      "method": "POST",
      "headers": {
        "X-Requested-With": "XMLHttpRequest",
        "Content-Type": "application/json"
      },
      "description": "Instant batch resolution of daily Omega/Omega II series quests."
    },
    "battleKeyCheck": {
      "path": "/quest/battle_key_check",
      "method": "POST",
      "headers": {
        "X-Requested-With": "XMLHttpRequest",
        "Content-Type": "application/json"
      },
      "description": "Validates and joins a raid using an 8-character battle key."
    },
    "multiResult": {
      "path": "/resultmulti/data.json",
      "method": "GET",
      "description": "Fetches multiplayer battle reward payload: blue chests, gold chests, MVP status, honors, and player rankings."
    }
