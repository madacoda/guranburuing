# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs, TypeScript Cache & Rust Cargo Artifacts
dist/
build/
target/
*.tsbuildinfo
.turbo/
*.dll
*.so
*.dylib
*.node
*.pdb
*.exp
*.lib
data/*.rkyv
data/.catalog.cache.bin

# Environment & Sensitive Credentials (STRICTLY FORBIDDEN FROM REPO)
.env
.env.*
!.env.example
accounts.config.json
accounts*.json
!accounts.config.example.json
data/*-cookies.json
*-cookies.json
data/.test-*
.test-*



# Local Chromium & Isolated Browser Profiles
.gbf-*-profile/
.gbf-profiles/
data/accounts/*
!data/accounts/.gitkeep
*.sqlite
*.db
*.leveldb

# Runtime Artifacts & Failure Captures
artifacts/*
!artifacts/.gitkeep
scratch/

# Runtime Logs & Telemetry Data
logs/*
!logs/.gitkeep
*.log
*.jsonl

# Screenshots & Media Captures
*.png
*.jpg
*.jpeg
*.webp
*.gif

